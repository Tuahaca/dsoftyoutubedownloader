{
  "manifest_version": 3,
  "name": "Dynamicsoft Youtube downloader",
  "short_name": "Dynamicsoft",
  "version": "0.1.0",
  "description": "Download YouTube videos (MP4) or audio (MP3/M4A) through a local yt-dlp helper app.",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Download this video",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["nativeMessaging", "storage", "notifications", "activeTab"],
  "host_permissions": ["*://*.youtube.com/*", "*://youtu.be/*"]
}
